// OkSelenized styles for aptitude — append to (or copy as) ~/.aptitude/config.
// Aptitude's defaults assume ANSI blue is dark and use it as background;
// with a lightness-normalized palette that gives ~1.2:1 contrast in the
// menu/header bars (jan-warchol/selenized#32). Restyle onto dark backgrounds:
// black=bg_1, cyan=accent, white+bold=fg_1.
Aptitude::UI::Styles {
  Header {fg white; bg black; set bold;};
  Status {fg white; bg black; set bold;};
  MenuBar {fg white; bg black; set bold;};
  HighlightedMenuBar {fg black; bg cyan;};
  MenuEntry {fg white; bg black;};
  HighlightedMenuEntry {fg black; bg cyan;};
  MenuBorder {fg white; bg black;};
  MultiplexTab {fg white; bg black;};
  MultiplexTabHighlighted {fg black; bg cyan;};
  Progress {fg black; bg cyan;};
  DownloadProgress {fg black; bg cyan;};
};
