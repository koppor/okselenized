// OkSelenized styles for aptitude — append to (or copy as) ~/.aptitude/config.
// Aptitude's defaults are white-on-blue, assuming ANSI blue is dark; with a
// lightness-normalized palette blue is *light* (L=67), so the default light
// text lands at ~1.2:1 contrast (jan-warchol/selenized#32). Keep the blue
// bars, flip the text dark: black=bg_1 on blue is 3.4:1, on cyan 3.6:1.
Aptitude::UI::Styles {
  Header {fg black; bg blue;};
  Status {fg black; bg blue;};
  MenuBar {fg black; bg blue;};
  HighlightedMenuBar {fg black; bg cyan;};
  MenuEntry {fg black; bg blue;};
  HighlightedMenuEntry {fg black; bg cyan;};
  MenuBorder {fg black; bg blue;};
  MultiplexTab {fg black; bg blue;};
  MultiplexTabHighlighted {fg black; bg cyan;};
  Progress {fg black; bg blue;};
  DownloadProgress {fg black; bg blue;};
};
